#!/bin/sh

# Shadow the real compiler and apply the Eternal compiler policy. GCC resolves
# -specs relative to its own library directory, so every spec is absolute. The
# build environment puts this directory before /usr/bin.
set -eu

name=${0##*/}

if [ -n "${GCC_SPEC_FILE:-}" ]; then
    spec=$GCC_SPEC_FILE
else
    cache=${TMPDIR:-/tmp}/.eternal-gcc-$name
    if [ -r "$cache" ]; then
        major=$(cat "$cache")
    else
        major=$(/usr/bin/"$name" -dumpversion 2>/dev/null |
            sed -n 's/^\([0-9][0-9]*\).*/\1/p')
        [ -n "$major" ] || major=default
        printf '%s\n' "$major" >"$cache" 2>/dev/null || true
    fi
    spec="/usr/lib/eternal/gcc/openssf-$major.spec"
    [ -f "$spec" ] || spec="/usr/lib/eternal/gcc/openssf-default.spec"
fi

case "$spec" in
    /*) ;;
    *) spec="/usr/lib/eternal/gcc/$spec" ;;
esac

arch_spec=
case "${RPMX_TARGET_ARCH:-$(uname -m)}" in
    x86_64|amd64)
        arch_spec=/usr/lib/eternal/gcc/openssf-arch-x86_64.spec
        ;;
    aarch64|arm64)
        arch_spec=/usr/lib/eternal/gcc/openssf-arch-aarch64.spec
        ;;
esac
[ -f "$arch_spec" ] || arch_spec=

if [ -n "$arch_spec" ]; then
    exec /usr/bin/"$name" -specs "$spec" -specs "$arch_spec" "$@"
fi
exec /usr/bin/"$name" -specs "$spec" "$@"
