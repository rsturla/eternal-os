-	&& grep -q "^program-does-not-exist: error while loading shared libraries: program-does-not-exist: cannot open shared object file$" "$tmp_out" \
+	&& grep -Eq "^program-does-not-exist: error while loading shared libraries: program-does-not-exist: cannot open shared object file(: No such file or directory)?$" "$tmp_out" \
 	&& test "$(wc -l < "$tmp_out")" -eq 1 ; then
     status=0
