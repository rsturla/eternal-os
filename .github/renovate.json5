{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Use the basic Renovate preset, and allow settings to be overridden
  "extends": [
    "config:best-practices"
  ],

  "packageRules": [
    {
      // Keep GitHub Actions current. Digests are pinned so every update is a
      // one-line review.
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "matchManagers": [
        "github-actions"
      ]
    }
  ],

  // The pinned rpmx revision is the single source of truth.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.rpmx-revision$/"],
      "matchStrings": ["(?<currentValue>[0-9a-f]{40})"],
      "depNameTemplate": "rsturla/rpmx",
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "git"
    }
  ]
}
