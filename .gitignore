# rpmx and local build output
out/
site/
test-results/
.rpmx/
*.rpm
# Keep signed-package and transaction test fixtures trackable.
!packages/*/tests/**/*.rpm
!bootstrap/recipes/*/tests/**/*.rpm

# Local package locks. The bootstrap root still follows live Fedora, so its
# closure moves independently of a recipe; commit locks only after the root is
# pinned and CI builds with --locked.
package.lock.json

# Nested defaults written by `rpmx init`; the repository has its own
packages/*/packages/
packages/*/.rpmx/

# Signing material must never be committed
*.key
*.secret
.secrets/
.env

# Editors and tooling
.vscode/
.idea/
.cache/
__pycache__/

# bootstrap build roots and the local toolchain repository
.work/
bootstrap/.work/
